{
 "description": "The contract: what the user wants (purpose, requests, examples, promised inputs and outputs, their decisions). How it is done (steps, data, the loop) is the design: comfy_propose_design.",
 "type": "object",
 "properties": {
  "contract": {
   "enum": [
    2,
    "2"
   ]
  },
  "purpose": {
   "type": "string",
   "minLength": 1,
   "maxLength": 600,
   "description": "1-3 sentences: who it is for, what it solves, what good looks like."
  },
  "requests": {
   "type": "array",
   "minItems": 1,
   "maxItems": 12,
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^R[0-9]{1,2}$"
     },
     "you_said": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "The user's own words, quoted as said."
     },
     "we_understood": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "Plain restatement, ideally 'When <situation>, the workflow <does what>.'"
     },
     "priority": {
      "enum": [
       "must",
       "should",
       "could"
      ]
     }
    },
    "required": [
     "id",
     "you_said",
     "we_understood",
     "priority"
    ],
    "additionalProperties": false
   }
  },
  "examples": {
   "type": "array",
   "maxItems": 8,
   "description": "Concrete input -> expected output pairs that show what the requests mean.",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^E[0-9]{1,2}$"
     },
     "covers": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^R[0-9]{1,2}$"
      },
      "minItems": 1
     },
     "given": {
      "type": "object",
      "additionalProperties": {
       "type": [
        "string",
        "number",
        "boolean"
       ]
      }
     },
     "expect": {
      "type": "object",
      "additionalProperties": {
       "type": [
        "string",
        "number",
        "boolean"
       ]
      }
     },
     "note": {
      "type": "string",
      "maxLength": 200
     }
    },
    "required": [
     "id",
     "covers",
     "given",
     "expect"
    ],
    "additionalProperties": false
   }
  },
  "promises": {
   "type": "object",
   "properties": {
    "inputs": {
     "type": "array",
     "maxItems": 12,
     "items": {
      "type": "object",
      "properties": {
       "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       },
       "kind": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "description": "text, number, image, mask, audio, video, file, ..."
       },
       "example": {
        "type": [
         "string",
         "number",
         "boolean"
        ]
       },
       "from": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}\\.[a-z][a-z0-9_]{0,31}$",
        "description": "Outputs: the step output that delivers it (\"step.port\"); makes it part of the API."
       },
       "node": {
        "type": [
         "integer",
         "string"
        ],
        "description": "Inputs: an existing top-level node (e.g. the user's given data folder) that is this input, instead of a new input node."
       },
       "widget": {
        "type": "string",
        "maxLength": 80,
        "description": "Inputs: the widget on that node the API sets (for a subgraph card, its promoted widget)."
       }
      },
      "required": [
       "name",
       "kind"
      ],
      "additionalProperties": false
     }
    },
    "outputs": {
     "type": "array",
     "minItems": 1,
     "maxItems": 12,
     "items": {
      "type": "object",
      "properties": {
       "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       },
       "kind": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "description": "text, number, image, mask, audio, video, file, ..."
       },
       "example": {
        "type": [
         "string",
         "number",
         "boolean"
        ]
       },
       "node": {
        "type": [
         "integer",
         "string"
        ],
        "description": "Inputs: an existing top-level node (e.g. the user's given data folder) that is this input, instead of a new input node."
       },
       "widget": {
        "type": "string",
        "maxLength": 80,
        "description": "Inputs: the widget on that node the API sets (for a subgraph card, its promoted widget)."
       }
      },
      "required": [
       "name",
       "kind"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "inputs",
    "outputs"
   ],
   "additionalProperties": false
  },
  "decisions": {
   "type": "array",
   "maxItems": 32,
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^D[0-9]{1,2}$"
     },
     "decision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
     },
     "why": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
     },
     "instead_of": {
      "type": "string",
      "maxLength": 300
     },
     "by": {
      "enum": [
       "user",
       "agent"
      ],
      "description": "user only for answers the user actually gave."
     },
     "pattern": {
      "type": "string",
      "maxLength": 60,
      "description": "The design pattern this decision applies, if any."
     },
     "principle": {
      "type": "string",
      "maxLength": 80,
      "description": "The engineering principle behind it (e.g. single responsibility, determinism)."
     }
    },
    "required": [
     "id",
     "decision",
     "why",
     "by"
    ],
    "additionalProperties": false
   }
  },
  "not_now": {
   "type": "array",
   "maxItems": 16,
   "items": {
    "type": "string",
    "minLength": 1,
    "maxLength": 300
   }
  },
  "open_questions": {
   "type": "array",
   "maxItems": 16,
   "items": {
    "oneOf": [
     {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
     },
     {
      "type": "object",
      "properties": {
       "question": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
       },
       "step": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$",
        "description": "The step that waits for the answer; the rest can be built."
       }
      },
      "required": [
       "question",
       "step"
      ],
      "additionalProperties": false
     }
    ]
   },
   "description": "A plain question must be answered before approval. A question tied to one step ({question, step}) may stay open: that step is built around it and cannot be verified until it is answered (by amending the contract)."
  }
 },
 "required": [
  "contract",
  "purpose",
  "requests",
  "examples",
  "promises",
  "decisions",
  "not_now",
  "open_questions"
 ],
 "additionalProperties": false
}
