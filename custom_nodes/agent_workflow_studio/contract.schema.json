{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow-studio.local/contract.schema.json",
  "title": "Agent Workflow Studio contract",
  "description": "One per workflow. Intent only: purpose, requests, examples, promises, steps, decisions. Step status and technical details are derived from the canvas and runs, never written here.",
  "type": "object",
  "properties": {
    "contract": {"const": 2},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 400, "description": "1-3 sentences: who it is for, what it solves, what good looks like."},
    "requests": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^R[0-9]{1,2}$"},
          "you_said": {"type": "string", "minLength": 1, "maxLength": 300, "description": "The user's own words, quoted as said."},
          "we_understood": {"type": "string", "minLength": 1, "maxLength": 300, "description": "Plain restatement, ideally 'When <situation>, the workflow <does what>.'"},
          "priority": {"enum": ["must", "should", "could"]}
        },
        "required": ["id", "you_said", "we_understood", "priority"],
        "additionalProperties": false
      }
    },
    "examples": {
      "type": "array", "maxItems": 8,
      "description": "Concrete input -> expected output pairs that show what the requests mean.",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^E[0-9]{1,2}$"},
          "covers": {"type": "array", "items": {"type": "string", "pattern": "^R[0-9]{1,2}$"}, "minItems": 1},
          "given": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
          "expect": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
          "note": {"type": "string", "maxLength": 200}
        },
        "required": ["id", "covers", "given", "expect"],
        "additionalProperties": false
      }
    },
    "promises": {
      "type": "object",
      "properties": {
        "inputs": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/port"}},
        "outputs": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/port"}}
      },
      "required": ["inputs", "outputs"],
      "additionalProperties": false
    },
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 300, "description": "What the step does, in plain words."},
          "approach": {"enum": ["fixed", "ai_planned", "ai_judgment"], "description": "fixed: deterministic nodes; ai_planned: a Fuzzy node plans it; ai_judgment: an LLM node decides."},
          "covers": {"type": "array", "items": {"type": "string", "pattern": "^R[0-9]{1,2}$"}, "minItems": 1},
          "gate": {
            "type": "object",
            "properties": {
              "says": {"type": "string", "minLength": 1, "maxLength": 300, "description": "How we know the step worked, in plain words."},
              "check": {
                "type": "object",
                "properties": {
                  "node": {"type": "string", "minLength": 1, "maxLength": 200, "description": "Exact title of the OUTPUT node (Preview, Save, ...) that proves the gate."},
                  "kind": {"enum": ["non_empty", "contains", "equals", "regex", "image_count_at_least"]},
                  "value": {"type": ["string", "integer"]}
                },
                "required": ["node", "kind"],
                "additionalProperties": false
              }
            },
            "required": ["says"],
            "additionalProperties": false
          },
          "nodes": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 200}, "description": "Technical: node class types expected for this step."}
        },
        "required": ["id", "purpose", "approach", "covers", "gate"],
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^D[0-9]{1,2}$"},
          "decision": {"type": "string", "minLength": 1, "maxLength": 300},
          "why": {"type": "string", "minLength": 1, "maxLength": 300},
          "instead_of": {"type": "string", "maxLength": 300},
          "by": {"enum": ["user", "agent"], "description": "user only for answers the user actually gave."}
        },
        "required": ["id", "decision", "why", "by"],
        "additionalProperties": false
      }
    },
    "not_now": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "open_questions": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 300}, "description": "Must be empty before approval."}
  },
  "required": ["contract", "purpose", "requests", "examples", "promises", "steps", "decisions", "not_now", "open_questions"],
  "additionalProperties": false,
  "$defs": {
    "port": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "kind": {"type": "string", "minLength": 1, "maxLength": 40, "description": "text, number, image, mask, audio, video, file, ..."},
        "example": {"type": ["string", "number", "boolean"]}
      },
      "required": ["name", "kind"],
      "additionalProperties": false
    }
  }
}
