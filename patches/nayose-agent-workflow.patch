+def test_train_job_pins_to_safe_generation_id(tmp_path, monkeypatch):
+    data_root = tmp_path / "data"
+    generation = data_root / "generations" / "gen_smoke_123"
+    generation.mkdir(parents=True)
+    (generation / "generation_manifest.json").write_text("{}", encoding="utf-8")
+    runner = AdminJobRunner(data_root, tmp_path / "models", Audit())
+    captured = {}
+
+    def fake_spawn(argv, _stage, _job_id, _env, _stream_progress=False):
+        captured["argv"] = argv
+        run = tmp_path / "models" / "runs" / "run_smoke"
+        run.mkdir(parents=True)
+        (run / "run_manifest.json").write_text(
+            '{"data_fingerprint":"abc","query_metrics":{}}', encoding="utf-8"
+        )
+
+    monkeypatch.setattr(runner, "_spawn", fake_spawn)
+    try:
+        result = runner._run_train({"generation_id": "gen_smoke_123"}, "job-1")
+    finally:
+        runner.close()
+
+    data_dir_index = captured["argv"].index("--data-dir")
+    assert captured["argv"][data_dir_index + 1] == str(generation.resolve())
+    assert result["fingerprint"] == "abc"
+
+
+def test_train_job_rejects_path_like_generation_id(tmp_path, monkeypatch):
+    runner = AdminJobRunner(tmp_path / "data", tmp_path / "models", Audit())
+    called = False
+
+    def fake_spawn(*_args, **_kwargs):
+        nonlocal called
+        called = True
+
+    monkeypatch.setattr(runner, "_spawn", fake_spawn)
+    try:
+        with pytest.raises(ValueError, match="invalid generation_id"):
+            runner._run_train({"generation_id": "../outside"}, "job-1")
+    finally:
+        runner.close()
+
+    assert not called
