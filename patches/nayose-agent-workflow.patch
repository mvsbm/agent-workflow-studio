+def test_admin_subprocess_resource_plan_does_not_override_runtime_device(monkeypatch):
+    import io
+    from types import SimpleNamespace
+
+    import api.infrastructure.process.admin_process as admin_process
+
+    output = io.StringIO()
+    logger = logging.getLogger("test-admin-subprocess-device")
+    logger.handlers.clear()
+    logger.setLevel(logging.INFO)
+    logger.addHandler(logging.StreamHandler(output))
+    monkeypatch.setenv("NAYOSE_DEVICE", "mps")
+    monkeypatch.setattr(
+        admin_process,
+        "load_config",
+        lambda: SimpleNamespace(performance=object()),
+    )
+
+    class FakeResourceManager:
+        def __init__(self, _path):
+            pass
+
+        def plan(self, **kwargs):
+            assert kwargs["requested_device"] == "cpu"
+            return SimpleNamespace(
+                env=lambda: {"NAYOSE_DEVICE": "cpu", "NAYOSE_CPU_THREADS": "1"},
+                cpu_threads=1,
+                model_threads=1,
+            )
+
+    monkeypatch.setattr(admin_process, "ResourceManager", FakeResourceManager)
+    runner = AdminProcessRunner(Path.cwd(), logger)
+    runner.run(
+        [sys.executable, "-c", "import os; print(os.environ['NAYOSE_DEVICE'])"],
+        "test",
+        "job-device",
+        {},
+        threading.Event(),
+        lambda _stage: None,
+        lambda *_update: None,
+        lambda _process: None,
+        lambda: None,
+    )
+
+    assert output.getvalue().strip() == "admin subprocess mps"
+
+
